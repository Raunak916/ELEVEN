# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large raw database dumps
*.duckdb
*.duckdb.*

# references and mock design assets
/public/references/
/public/*-reference.*
*reference*

# temporary scratch json dumps
/leg.json
/leg2.json
/mar.json
/pel.json

# documentation files ignored per user preference
decision.md
flow.md

# SQLite runtime journals
*.db-shm
*.db-wal


